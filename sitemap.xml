---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{{ '/sitemap.xsl' | relative_url }}"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% if page.url contains '.xml' or page.url contains '.css' or page.sitemap == false %}{% continue %}{% endif %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: 'index.html' }}</loc>
      <priority>{{ page.sitemap_priority | default: page.sitemap.priority | default: 0.5 }}</priority>
    </url>
  {% endfor %}
</urlset>